# Cadence - Environment Variables
# Copy to .env and fill values. NEVER commit .env to git.
# Cadence runs fully without ANY keys: Razorpay calls and channels fall back
# to built-in simulators so the demo works offline. Add keys only when you
# want real (test-mode) integrations.

# ============================================================================
# Razorpay (TEST MODE keys only - dashboard > Settings > API Keys > Test)
# Set both RZP_KEY_ID and RZP_KEY_SECRET to flip /api/status to mode=LIVE.
# Without these, the live Razorpay HTTP client is not constructed.
# ============================================================================
RZP_KEY_ID=
RZP_KEY_SECRET=
# Set this to the same value you'll paste into Supabase Edge Function
# secrets. Default is the dev value (insecure for production).
RZP_WEBHOOK_SECRET=revive_dev_webhook_secret

# ============================================================================
# LLM provider chain (one or more; order = fallback)
# Setting any one of these keys flips llm_keys_present=true. The provider
# chain is invoked in order until one answers.
#
# gemini  : https://aistudio.google.com/apikey    (free tier, no card)
# groq    : https://console.groq.com/keys         (free tier, no card)
# openrouter : https://openrouter.ai/keys         (free models)
# sarvam  : https://dashboard.sarvam.ai            (Indian-first; 22 langs;
#            free tier; OpenAI-compatible at /v1/chat/completions)
# ollama  : local - install ollama.com then `ollama pull llama3.1:8b`
# ============================================================================
LLM_PROVIDER_ORDER=gemini,groq,openrouter
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
SARVAM_API_KEY=
LLM_MODEL_GEMINI=gemini-2.0-flash
LLM_MODEL_GROQ=llama-3.3-70b-versatile
LLM_MODEL_OPENROUTER=meta-llama/llama-3.3-70b-instruct:free
LLM_MODEL_SARVAM=sarvam-m
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_MODEL_OLLAMA=llama3.1:8b

# Hard daily ceiling on LLM usage (Rule F cost cap). Planner refuses past
# this and falls back to the deterministic fast path. The Cap applies per
# provider; the planner is just forbidden past the total.
LLM_DAILY_REQUEST_CAP=400

# ============================================================================
# Channels
# ============================================================================
# Resend (transactional email). Set this to send real recovery emails.
# Without it, sends are simulated (logged only).
# Get one at https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=cadence@example.com

# Public base URL of this API; nudge messages link to
# {PAGE_BASE_URL}/pay/{journey_id}
PAGE_BASE_URL=http://localhost:8000

# ============================================================================
# Recovery policy knobs (defaults shown; rarely need to change)
# ============================================================================
TOUCH_CAP_PER_WINDOW=3
TOUCH_WINDOW_DAYS=14
MAX_RETRY_ATTEMPTS=3
QUIET_HOURS_START=21
QUIET_HOURS_END=9
TIMEZONE=Asia/Kolkata
# Guardian cost ceiling: amounts below this (minor units) stop after 2+ attempts
MIN_RECOVERY_WORTH_MINOR=10000

# ============================================================================
# Cloud mirror (Supabase)
# Set SUPABASE_URL + SUPABASE_SERVICE_KEY + CLOUD_SYNC_ENABLED=true to
# activate the one-way mirror. Without these, the mirror endpoint reports
# sync_state=offline and the worker never opens a connection.
# Get these from https://supabase.com/dashboard/project/_/settings/api
# ============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Explicit toggle (default false) so the worker doesn't try to upsert
# before you've applied the schema in supabase/schema.sql
CLOUD_SYNC_ENABLED=false

# ============================================================================
# Runtime
# ============================================================================
HOST=127.0.0.1
PORT=8000
DB_PATH=data/revive.db
LOG_LEVEL=INFO
