# Revive ignore patterns (root)

# Cloned reference repos and kit scaffolding (do not commit)
OdooHackathon/
Smart-Well-Management/
frontend_backup_*.zip
.kit_backup/
.opencode/
graphify-out/

# Private (author's reference) docs - not for public repo / judges
private/
Cadence/private/
Cadence/docs/private/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Venv
.venv/
venv/
env/

# SQLite WAL/SHM (keep the .db itself out of git, but make it clear)
*.db-wal
*.db-shm

# Local env
.env.local
.env.*.local

# Local DB (regenerated by scripts/seed.py)
data/*.db

# Logs
logs/
*.log
Cadence/logs/
Cadence/*.log

# Node / frontend
Cadence/frontend/node_modules/
Cadence/frontend/dist/
Cadence/frontend/.vite/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Build artifacts
Cadence/frontend/src/revive/console/dist/

# Python editable-install metadata (regenerated on every `pip install -e`)
Cadence/src/revive.egg-info/
*.egg-info/
*.egg

